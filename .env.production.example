# Set these in the hosting provider's environment settings.
DJANGO_SETTINGS_MODULE=crm_project.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=crm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
MEDIA_ROOT=/data/media
# Enable only when the host's trusted HTTPS proxy sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=true
# Mount a persistent disk at /data for uploads and attendance records.
# Release command: python manage.py migrate --noinput
# Worker command (same database): python manage.py send_due_reminders --loop --interval 5
# Configure WEBPUSH_VAPID_PUBLIC_KEY, WEBPUSH_VAPID_PRIVATE_KEY and
# WEBPUSH_VAPID_SUBJECT on both the web service and reminder worker.
